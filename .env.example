# 复制成 .dev.vars 用于本地开发；线上使用 wrangler secret put，严禁提交真实值。
TENCENTCLOUD_SECRET_ID=replace-with-your-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-your-secret-key
OAUTH_PASSWORD=replace-with-at-least-16-random-characters
OAUTH_JWT_SECRET=replace-with-at-least-32-independent-random-characters
# 可选 STS 临时凭证
# TENCENTCLOUD_TOKEN=replace-with-your-sts-token

# 默认只读；开启写入前同时设置三项并核验 CAM 权限。
DNSPOD_READ_ONLY=true
DNSPOD_ALLOW_DESTRUCTIVE=false
DNSPOD_WRITE_DOMAINS=
# 可选：限制 OAuth 客户端注册的精确回调 URL（英文逗号分隔）。
# OAUTH_ALLOWED_REDIRECT_URIS=https://client.example/callback
# 可选：浏览器跨域来源；服务端 MCP 连接不需要通配 CORS。
# CORS_ALLOWED_ORIGINS=https://client.example
